# Copy to .env and fill in. Never commit .env.

# Stripe (test mode until you switch to live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or Dashboard → Webhooks

# Public site origin used for Checkout success/cancel URLs
ORIGIN=http://localhost:5173
PORT=4242

# Admin Store Manager
ADMIN_PIN=1234                    # initial PIN (local/dev). Change PIN persists to data/admin/pin.json
ADMIN_SESSION_SECRET=             # optional; auto-generated into data/admin/session-secret.json if empty
