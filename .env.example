# Copy to .env and fill in. Never commit .env.

# Stripe (test mode until you switch to live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # REQUIRED in production (fail-closed → 503 if missing)

# Public site origin used for Checkout success/cancel URLs (prod: https://inkcrediblepens.org)
ORIGIN=http://localhost:5173
PORT=4242
NODE_ENV=development

# Express trust proxy hops (Cloudflare Tunnel / Caddy → Node = 1; CF → Caddy → Node = 2)
# TRUST_PROXY=1

# Production hardening is also implied when ORIGIN is https://inkcrediblepens.org
# or any non-localhost HTTPS URL, or REQUIRE_STRIPE_WEBHOOK=1
# REQUIRE_STRIPE_WEBHOOK=1

# Local/dev only: allow unsigned webhook body parse when STRIPE_WEBHOOK_SECRET is unset.
# Ignored / never unlocks unsigned parse when production hardening is on.
# ALLOW_INSECURE_WEBHOOK=1

# Admin Store Manager
# Local/dev may omit or use 1234 (loud warning). Production REFUSES to start if missing or 1234.
ADMIN_PIN=1234
ADMIN_SESSION_SECRET=             # optional; auto-generated into data/admin/session-secret.json if empty

# Paid-order email notifications (Resend)
# Leave RESEND_API_KEY / ORDER_FROM_EMAIL unset until the sending domain is verified.
# The worker stays alive but sends nothing while required email config is missing.
# Never commit a real Resend API key.
# RESEND_API_KEY=re_...
# ORDER_FROM_EMAIL=Inkcredible Pens <orders@inkcrediblepens.org>
# ORDER_NOTIFICATION_EMAIL=inkcredible.pens@gmail.com
# ORDER_REPLY_TO=inkcredible.pens@gmail.com
# EMAIL_POLL_SECONDS=15
# First worker start skips paid orders that already exist. Set to 1 only for an intentional backfill.
# EMAIL_SEND_EXISTING_ORDERS=0

# Retention (days) for abandoned custom uploads + pending checkout JSON (default 7)
# UPLOAD_RETENTION_DAYS=7
# CHECKOUT_RETENTION_DAYS=7
