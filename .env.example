# Copy to .env and fill in. Never commit .env.

# Stripe (test mode until you switch to live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # REQUIRED in production (fail-closed → 503 if missing)

# Public site origin used for Checkout success/cancel URLs (prod: https://inkcredible.kennedyshome.com)
ORIGIN=http://localhost:5173
PORT=4242
NODE_ENV=development

# Express trust proxy hops (Cloudflare Tunnel / Caddy → Node = 1; CF → Caddy → Node = 2)
# TRUST_PROXY=1

# Production hardening is also implied for any non-localhost HTTPS ORIGIN
# (including https://inkcredible.kennedyshome.com), or REQUIRE_STRIPE_WEBHOOK=1
# REQUIRE_STRIPE_WEBHOOK=1

# Local/dev only: allow unsigned webhook body parse when STRIPE_WEBHOOK_SECRET is unset.
# Ignored / never unlocks unsigned parse when production hardening is on.
# ALLOW_INSECURE_WEBHOOK=1

# Admin Store Manager
# Local/dev may omit or use 1234 (loud warning). Production REFUSES to start if missing or 1234.
ADMIN_PIN=1234
ADMIN_SESSION_SECRET=             # optional; auto-generated into data/admin/session-secret.json if empty

# Paid-order email notifications (Resend)
# Leave RESEND_API_KEY / ORDER_FROM_EMAIL unset until inkcredible.kennedyshome.com is verified.
# orders@inkcredible.kennedyshome.com is a From address; it does not need its own mailbox.
# Customer replies go to ORDER_REPLY_TO.
# The worker stays alive but sends nothing while required email config is missing.
# Never commit a real Resend API key.
# RESEND_API_KEY=re_...
# ORDER_FROM_EMAIL=Inkcredible Pens <orders@inkcredible.kennedyshome.com>
# Comma-separated shop recipients; each receives the new paid-order notice.
# ORDER_NOTIFICATION_EMAILS=inkcredible.pens@gmail.com,chadakennedy86@gmail.com
# ORDER_REPLY_TO=inkcredible.pens@gmail.com
# EMAIL_POLL_SECONDS=15
# First worker start skips paid orders that already exist. Set to 1 only for an intentional backfill.
# EMAIL_SEND_EXISTING_ORDERS=0

# Retention (days) for abandoned custom uploads + pending checkout JSON (default 7)
# UPLOAD_RETENTION_DAYS=7
# CHECKOUT_RETENTION_DAYS=7
# Public social-post staging images (uploaded only through the OAuth-protected MCP tool)
# SOCIAL_UPLOAD_RETENTION_DAYS=30

# Package tracking via 17TRACK (optional). Free key: https://api.17track.net → API settings.
# Without this key, watching is disabled; manual order status still works.
# TRACK17_API_KEY=
# TRACKING_POLL_MINUTES=45

# Private ChatGPT listing workflow (Auth0 OAuth)
# AUTH0_ISSUER_BASE_URL=https://YOUR-TENANT.us.auth0.com
# AUTH0_AUDIENCE=https://inkcredible.kennedyshome.com/mcp
# AUTH0_EMAIL_CLAIM=https://inkcredible.kennedyshome.com/email
# AUTH0_EMAIL_VERIFIED_CLAIM=https://inkcredible.kennedyshome.com/email_verified
# LISTING_ALLOWED_EMAILS=chadakennedy86@gmail.com,kelliekennedy81@gmail.com
# PUBLIC_ORIGIN=https://inkcredible.kennedyshome.com
