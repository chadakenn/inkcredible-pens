# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env / secrets
.env
.env.*
!.env.example

# Uploads (keep folders via .gitkeep; ignore binaries)
uploads/*
!uploads/.gitkeep
!uploads/custom/
uploads/custom/*
!uploads/custom/.gitkeep
!uploads/products/
uploads/products/*
!uploads/products/.gitkeep

# Shared orders JSON (keep folder via .gitkeep)
data/orders/*
!data/orders/.gitkeep

# Shared product catalog JSON (keep folder via .gitkeep)
data/catalog/*
!data/catalog/.gitkeep

# Admin secrets / changed PIN (keep folder via .gitkeep)
data/admin/*
!data/admin/.gitkeep

# Pending Stripe checkouts (keep folder via .gitkeep)
data/checkouts/*
!data/checkouts/.gitkeep

# Paid-order email delivery state (keep folder via .gitkeep)
data/email/*
!data/email/.gitkeep

# Rolling JSON backups
*.json.bak
*.json.*.bak
